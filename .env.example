# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE CONFIGURATION (Free Tier)
# Enter your Supabase Project URL (e.g., https://xyzcompany.supabase.co) and anon/publishable key
# via the Secrets panel in AI Studio or in your local .env file.
# NEVER put your service_role secret key in the Android app!
# When left as placeholders below, the app runs in clearly labeled Local Demo Mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional configurable WhatsApp contact URL for customer support
RESTAURANT_WHATSAPP_URL=https://wa.me/21671000111
