    <string name="profile_about_title">À propos de Dominos Tunisie</string>
    <string name="profile_about_desc">Application native Android construite avec Jetpack Compose et Supabase PostgreSQL Free Tier. Paiement exclusivement à la livraison (Cash on Delivery) en dinars tunisiens (TND).</string>
